# Semua nilai di bawah ini opsional. Salin file ini menjadi .env
# hanya jika kamu ingin mengubah batas bawaan.

# Durasi video maksimum dalam detik (bawaan 900 = 15 menit).
MAX_DURATION_SECONDS=900

# Ukuran file maksimum dalam MB.
MAX_FILESIZE_MB=500

# Jumlah unduhan yang boleh berjalan bersamaan.
MAX_PARALLEL_JOBS=2

# Batas waktu satu proses unduh, dalam detik.
DOWNLOAD_TIMEOUT_SECONDS=180

# Port aplikasi lokal.
PORT=8000

# Folder file sementara. Kosongkan untuk memakai folder temp sistem
# ditambah "vdl". Contoh: TEMP_DIR=C:\Users\Nama\AppData\Local\Temp\vdl
TEMP_DIR=
